{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "${CLAUDE_PROJECT_DIR}/hooks/approve.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "${CLAUDE_PROJECT_DIR}/hooks/start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "${CLAUDE_PROJECT_DIR}/hooks/stop.sh"
          }
        ]
      }
    ]
  }
}